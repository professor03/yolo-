# Load with uvicorn --env-file .env. Never commit .env.
DISABLE_CAMERA_STREAMS=true
YOLO_DEMO_MODE=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional legacy API-key authentication; empty means disabled.
YOLO_API_KEY=
RTSP_CAMERA_URL=
MJPG_CAMERA_URL=
DATASTORE_PATH=data/datastore.json
DATABASE_URL=sqlite:///data/yolo_detection.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
